{
  "name": "sylla-collaborations",
  "version": "1.0.0",
  "description": "Plateforme officielle de partenariats et collaborations pour l'écosystème Sylla",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "start": "cd server && npm start",
    "seed": "cd server && npm run prisma:seed",
    "test": "npx tsx tests/e2e-functional-security.test.ts"
  },
  "keywords": [
    "sylla",
    "collaborations",
    "partenariat"
  ],
  "author": "Équipe Sylla",
  "license": "ISC"
}
